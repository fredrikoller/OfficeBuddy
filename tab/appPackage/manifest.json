{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Consid AB",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termsofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "office-buddy-tab${{APP_NAME_SUFFIX}}",
    "full": "Full name for office-buddy-tab"
  },
  "description": {
    "short": "Short description of office-buddy-tab",
    "full": "Full description of office-buddy-tab"
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "bots": [],
  "composeExtensions": [],
  "configurableTabs": [
    {
      "configurationUrl": "${{TAB_ENDPOINT}}/tabs/home/config",
      "canUpdateConfiguration": true,
      "scopes": ["team"],
      "context": ["channelTab"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["${{TAB_DOMAIN}}"]
}
